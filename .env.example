# core / districtsolutions.ai environment configuration
# copy to .env and fill in values

# --- domain ---
DOMAIN=districtsolutions.ai
ADMIN_EMAIL=hello@districtsolutions.ai

# --- nginx basic auth (protected endpoints until go-live) ---
HTPASSWD_USER=kevin
HTPASSWD_PASS=changeme

# --- pgadmin ---
PGADMIN_EMAIL=admin@districtsolutions.ai
PGADMIN_PASSWORD=changeme

# --- postgres ---
POSTGRES_DB=biztool
POSTGRES_USER=biztool
POSTGRES_PASSWORD=changeme

# task DB connection (used by api + worker)
POSTGRES_TASK_USER=biztool
POSTGRES_TASK_PW=changeme
POSTGRES_TASK_FQDN=biz-tool-postgres
POSTGRES_TASK_PORT=5432
POSTGRES_TASK_DB_NAME=biztool

# --- AWS ---
ENV_NAME=prod
AWS_REGION=us-east-1
TASK_BUCKET=biz-tool-prod-task-data

# --- open webui ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_API_BASE_URL=
OWEB_SECRET_KEY=changeme
OWEB_JWT_EXPIRES_IN=-1
OWEB_CORS_ALLOW_ORIGIN=https://kbaas.districtsolutions.ai
OWEB_DATABASE_URL=sqlite:////app/backend/data/webui.db

# --- pipelines (OpenWebUI custom models) ---
GOOGLE_API_KEY=
GROK_API_KEY=
AWS_ACCESS_KEY_BEDROCK=
AWS_SECRET_KEY_BEDROCK=
AWS_REGION_NAME_BEDROCK=us-east-1

# --- mattermost (msg.districtsolutions.ai) ---
MM_DB_USER=mattermost
MM_DB_PASSWORD=changeme
MM_DB_NAME=mattermost

# --- api ---
DB_ENABLED=1
S3_ENABLED=1
CORS_ORIGINS=https://districtsolutions.ai,https://kbaas.districtsolutions.ai,https://aisoc.districtsolutions.ai

# --- SOC agent (aisoc.districtsolutions.ai) ---
SOC_DB_USER=socagent
SOC_DB_PASSWORD=changeme
SOC_DATABASE_URL=postgresql://socagent:changeme@biz-tool-postgres:5432/socagent
# Azure Sentinel
SENTINEL_TENANT_ID=
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=
SENTINEL_WORKSPACE_ID=
SENTINEL_SUBSCRIPTION_ID=
SENTINEL_RESOURCE_GROUP=
SENTINEL_WORKSPACE_NAME=
# Wiz
WIZ_CLIENT_ID=
WIZ_CLIENT_SECRET=
# Qualys
QUALYS_USERNAME=
QUALYS_PASSWORD=
QUALYS_API_URL=https://qualysapi.qualys.com
# Snyk
SNYK_API_TOKEN=
SNYK_ORG_ID=
# Notifications
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=
# LangSmith (optional tracing)
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=soc-agent

# --- contact form email (AWS SES) ---
# SES uses the EC2 IAM role - no credentials needed
# Deploy stack/cf/ses/ses.yaml first, then add DKIM DNS records
SES_FROM_EMAIL=noreply@districtsolutions.ai
SES_CONFIG_SET=biz-tool-prod
CONTACT_NOTIFY_EMAIL=contact@districtsolutions.ai
